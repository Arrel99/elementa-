[gd_resource type="Theme" load_steps=9 format=3]

; Theme global Elementa. Didaftarkan di project.godot lewat
; [gui] theme/custom="res://themes/elementa.tres" sehingga berlaku untuk SEMUA
; tombol, panel, dan label tanpa perlu theme_override di tiap scene.
;
; Palet diambil dari papan (game.tscn) supaya tampilan menyatu:
;   latar gelap   Color(0.0549019, 0.0823529, 0.117647)
;   panel         Color(0.101961, 0.152941, 0.203922)
;   garis         Color(0.235294, 0.360784, 0.470588)
;   aksen hijau   Color(0.462745, 0.827451, 0.6)
;
; Hover sengaja memakai dua perubahan sekaligus (isi panel DAN garis tepi)
; supaya mustahil terlewat di monitor apa pun.


[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/screens/lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")

[node name="V" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -310.0
offset_right = 360.0
offset_bottom = 310.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="V"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Main Berdua"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="V"]
layout_mode = 2
text = "Kedua pemain harus di WiFi/hotspot yang sama. Tidak perlu tahu IP."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Panels" type="HBoxContainer" parent="V"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="HostBox" type="PanelContainer" parent="V/Panels"]
